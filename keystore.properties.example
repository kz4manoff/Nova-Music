# Release Keystore Configuration for NOVA MUSIC
# Copy this file to `keystore.properties` (never commit real passwords or .jks files).
#
# Generate a release keystore with:
# keytool -genkeypair -v -keystore nova-release.jks -alias nova_release -keyalg RSA -keysize 2048 -validity 10000

storeFile=nova-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=nova_release
keyPassword=CHANGE_ME_KEY_PASSWORD
